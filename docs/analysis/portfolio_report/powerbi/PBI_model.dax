// =============================================================================
//  PBI_model.dax — весь DAX модели «Отчёт по портфелю», витки 0–2.
//  Канонический источник для вставки. POWERBI.md объясняет «почему»,
//  этот файл — «что вставить». Расходятся — прав этот файл.
//
//  Порядок вставки — BUILD.md. Каждый блок вставляется отдельно:
//    ТАБЛИЦА  → Моделирование → Новая таблица
//    СТОЛБЕЦ  → выделить таблицу → Новый столбец
//    МЕРА     → выделить таблицу «Меры» → Новая мера
//
//  Единицы зашиты в имена мер: «млрд ₸», «млн ₸», «мес», доли — в процентах.
//  Так в одной матрице рядом стоят суммы, штуки и доли, и каждая показана
//  в своём масштабе.
// =============================================================================


// ─────────────────────────────────────────────────────────────────────────────
//  1. ТАБЛИЦЫ
// ─────────────────────────────────────────────────────────────────────────────

// ТАБЛИЦА
dim_source =
DATATABLE (
    "l_source", STRING, "Источник", STRING, "Порядок", INTEGER,
    {
        { "S01", "RS",         1 },
        { "S02", "Карты",      2 },
        { "S03", "CrediLogic", 3 },
        { "S17", "Fenix",      4 }
    }
)

// ТАБЛИЦА
dim_month =
VAR _mn = MIN ( MIN ( fact_flow[month_start] ), MIN ( fact_stock[month_start] ) )
VAR _mx = MAX ( MAX ( fact_flow[month_start] ), MAX ( fact_stock[month_start] ) )
RETURN
    ADDCOLUMNS (
        FILTER ( CALENDAR ( _mn, _mx ), DAY ( [Date] ) = 1 ),
        "month_idx", YEAR ( [Date] ) * 12 + MONTH ( [Date] ),
        "Месяц",     FORMAT ( [Date], "yyyy-MM" )
    )

// СТОЛБЕЦ в dim_month
Последние 12 = dim_month[month_idx] > MAX ( dim_month[month_idx] ) - 12

// ТАБЛИЦА — ключи продукта. Подписи и «обеспеченные» — предложение, подтверждает автор
// (POWERBI.md, виток 2). П1/П2/П3 — сортировка уровней: у каждого значения уровня
// ровно один номер, иначе «Сортировать по столбцу» откажет.
dim_product =
DATATABLE (
    "product_key", STRING, "Обеспечение", STRING, "Группа", STRING, "Продукт", STRING,
    "П1", INTEGER, "П2", INTEGER, "П3", INTEGER,
    {
        { "S03|CAR|NewCarLoan",        "Обеспеченные",      "Автокредиты",    "Новые авто",                   1, 11, 11 },
        { "S03|CAR|UsedCarLoan",       "Обеспеченные",      "Автокредиты",    "Авто с пробегом",              1, 11, 12 },
        { "S03|POS|POS",               "Необеспеченные",    "Товарные (POS)", "POS — CrediLogic",             2, 21, 21 },
        { "S17|POS|POS",               "Необеспеченные",    "Товарные (POS)", "POS — Fenix",                  2, 21, 22 },
        { "S03|DSL|Payroll",           "Необеспеченные",    "Денежные",       "Зарплатные",                   2, 22, 31 },
        { "S03|DSL|Loyalty",           "Необеспеченные",    "Денежные",       "Loyalty",                      2, 22, 32 },
        { "S03|DSL|UnsecuredCashLoan", "Необеспеченные",    "Денежные",       "Беззалоговые наличными",       2, 22, 33 },
        { "S03|DSL|CashOnline",        "Необеспеченные",    "Денежные",       "Онлайн наличными",             2, 22, 34 },
        { "S03|CC|CreditCard",         "Необеспеченные",    "Карты",          "Кредитные карты — CrediLogic", 2, 23, 41 },
        { "S02|CARD",                  "Необеспеченные",    "Карты",          "Карты — S02",                  2, 23, 42 },
        { "S17|—|—",                   "Не размечено",      "Fenix",          "Fenix: продукт не указан",     3, 31, 51 },
        { "S01|РБ",                    "RS",                "РБ",             "RS · РБ",                      4, 41, 61 },
        { "S01|МБ",                    "RS",                "МБ",             "RS · МБ",                      4, 42, 62 },
        { "S01|КБ",                    "RS",                "КБ",             "RS · КБ",                      4, 43, 63 },
        { "S01|Приват-банкинг",        "RS",                "Приват-банкинг", "RS · Приват-банкинг",          4, 44, 64 },
        { "S01|—",                     "RS",                "не указан",      "RS · не указан",               4, 45, 65 },
        { "S01|нет договора",          "Счёт без договора", "без договора",   "S01 · без договора",           5, 51, 71 },
        { "S02|нет договора",          "Счёт без договора", "без договора",   "S02 · без договора",           5, 51, 72 },
        { "S03|нет договора",          "Счёт без договора", "без договора",   "S03 · без договора",           5, 51, 73 },
        { "S17|нет договора",          "Счёт без договора", "без договора",   "S17 · без договора",           5, 51, 74 }
    }
)

// ТАБЛИЦА — список показателей для раскладки «блок на показатель».
// Формат читается мерой [Значение] как динамическая строка формата.
Показатель =
DATATABLE (
    "Показатель", STRING, "Раздел", STRING, "Порядок", INTEGER, "Формат", STRING,
    {
        { "Объём выдач, млрд ₸",                        "2-1 Новые выдачи", 1,  "#,0.0"  },
        { "Количество выдач",                           "2-1 Новые выдачи", 2,  "#,0"    },
        { "Средняя сумма выдачи, млн ₸",                "2-1 Новые выдачи", 3,  "#,0.00" },
        { "Срок по договору, мес",                      "2-1 Новые выдачи", 4,  "#,0.0"  },
        { "Лимиты по картам, млн ₸",                    "2-1 Новые выдачи", 5,  "#,0.0"  },
        { "Полностью погашено",                         "2-3 Погашения",    6,  "#,0"    },
        { "в т.ч. досрочно",                            "2-3 Погашения",    7,  "#,0"    },
        { "Доля досрочных",                             "2-3 Погашения",    8,  "0.0%"   },
        { "Фактический срок, мес",                      "2-3 Погашения",    9,  "#,0.0"  },
        { "Закрыто с просрочкой на начало месяца",      "2-3 Погашения",    10, "#,0"    },
        { "Общий остаток, млрд ₸",                      "3 Портфель",       11, "#,0.0"  },
        { "Договоров с остатком",                       "3 Портфель",       12, "#,0"    },
        { "Заёмщиков с остатком",                       "3 Портфель",       13, "#,0"    },
        { "Остаток на заёмщика, млн ₸",                 "3 Портфель",       14, "#,0.00" },
        { "Управленческий уровень просрочки",           "4-1 Качество",     15, "0.0%"   },
        { "Просроченная задолженность (1424), млрд ₸",  "5 Просрочка",      16, "#,0.00" },
        { "Провизии (1428+1845+18771), млрд ₸",         "Провизии",         17, "#,0.0"  },
        { "Покрытие провизиями",                        "Провизии",         18, "0.0%"   },
        { "Счёт 1484, млрд ₸",                          "Провизии",         19, "#,0.0"  },
        { "Счёт 1485, млрд ₸",                          "Провизии",         20, "#,0.0"  }
    }
)


// ─────────────────────────────────────────────────────────────────────────────
//  2. МЕРЫ — все в таблице «Меры»
//     Поток складывается по месяцам. Запас — нет: берётся последний месяц
//     контекста, где есть остаток (LASTNONBLANK). Заёмщики не складываются
//     ни между продуктами, ни между источниками.
// ─────────────────────────────────────────────────────────────────────────────

// МЕРА (служебная, скрыть)
_Остаток (сумма) = SUM ( fact_stock[balance] )

// ── 2-1 Новые выдачи ─────────────────────────────────────────────────────────
// МЕРА
Объём выдач, млрд ₸ = DIVIDE ( SUM ( fact_flow[issued_amount] ), 1000000000 )

// МЕРА
Количество выдач = SUM ( fact_flow[issued_cnt] )

// МЕРА
Средняя сумма выдачи, млн ₸ =
DIVIDE ( SUM ( fact_flow[issued_amount] ), SUM ( fact_flow[issued_cnt_amount_pos] ) ) / 1000000

// МЕРА
Срок по договору, мес = DIVIDE ( SUM ( fact_flow[term_sum] ), SUM ( fact_flow[term_cnt] ) )

// МЕРА
Лимиты по картам, млн ₸ = DIVIDE ( SUM ( fact_flow[card_limit_amount] ), 1000000 )

// ── 2-3 Погашения: без договоров, просроченных на начало месяца (Р-4) ─────────
// МЕРА
Полностью погашено = SUM ( fact_flow[closed_cnt] ) - SUM ( fact_flow[closed_overdue_cnt] )

// МЕРА
в т.ч. досрочно = SUM ( fact_flow[closed_early_cnt] ) - SUM ( fact_flow[closed_overdue_early_cnt] )

// МЕРА
Доля досрочных =
DIVIDE (
    [в т.ч. досрочно],
    SUM ( fact_flow[closed_cnt_sched] ) - SUM ( fact_flow[closed_overdue_sched_cnt] )
)

// МЕРА
Фактический срок, мес =
DIVIDE (
    SUM ( fact_flow[closed_days_sum] ) - SUM ( fact_flow[closed_overdue_days_sum] ),
    SUM ( fact_flow[closed_days_cnt] ) - SUM ( fact_flow[closed_overdue_days_cnt] )
) / 30.4375

// МЕРА
Закрыто с просрочкой на начало месяца = SUM ( fact_flow[closed_overdue_cnt] )

// МЕРА (сноска)
S17 Т = SUM ( fact_flow[closed_t_cnt] )

// ── 3 Портфель ───────────────────────────────────────────────────────────────
// МЕРА
Общий остаток, млрд ₸ =
CALCULATE ( [_Остаток (сумма)], LASTNONBLANK ( dim_month[Date], [_Остаток (сумма)] ) ) / 1000000000

// МЕРА
Договоров с остатком =
CALCULATE ( SUM ( fact_stock[contracts_with_balance] ),
            LASTNONBLANK ( dim_month[Date], [_Остаток (сумма)] ) )

// МЕРА — есть только у одного продукта или у источника целиком; на группах и итоге банка пусто
Заёмщиков с остатком =
VAR _anchor = LASTNONBLANK ( dim_month[Date], [_Остаток (сумма)] )
RETURN
    SWITCH (
        TRUE (),
        HASONEVALUE ( dim_product[product_key] ),
            CALCULATE ( SUM ( fact_stock[borrowers_with_balance] ), _anchor ),
        HASONEVALUE ( dim_source[l_source] ) && NOT ISFILTERED ( dim_product ),
            CALCULATE ( SUM ( fact_borrowers[borrowers_with_balance] ), _anchor )
    )

// МЕРА
Остаток на заёмщика, млн ₸ =
DIVIDE (
    CALCULATE ( [_Остаток (сумма)], LASTNONBLANK ( dim_month[Date], [_Остаток (сумма)] ) ),
    [Заёмщиков с остатком]
) / 1000000

// ── 4-1 / 5 Качество и просрочка ─────────────────────────────────────────────
// МЕРА
Управленческий уровень просрочки =
DIVIDE (
    CALCULATE ( SUM ( fact_stock[balance_of_overdue] ), LASTNONBLANK ( dim_month[Date], [_Остаток (сумма)] ) ),
    CALCULATE ( [_Остаток (сумма)],                     LASTNONBLANK ( dim_month[Date], [_Остаток (сумма)] ) )
)

// МЕРА
Просроченная задолженность (1424), млрд ₸ =
CALCULATE ( SUM ( fact_stock[overdue_principal] ),
            LASTNONBLANK ( dim_month[Date], [_Остаток (сумма)] ) ) / 1000000000

// ── Провизии. С 06.2026 формула неполна по S03 (Р-5, Р-6) ─────────────────────
// МЕРА
Провизии (1428+1845+18771), млрд ₸ =
CALCULATE ( SUM ( fact_stock[provisions] ),
            LASTNONBLANK ( dim_month[Date], [_Остаток (сумма)] ) ) / 1000000000

// МЕРА
Покрытие провизиями =
DIVIDE (
    CALCULATE ( SUM ( fact_stock[provisions] ), LASTNONBLANK ( dim_month[Date], [_Остаток (сумма)] ) ),
    CALCULATE ( [_Остаток (сумма)],             LASTNONBLANK ( dim_month[Date], [_Остаток (сумма)] ) )
)

// МЕРА
Счёт 1484, млрд ₸ =
CALCULATE ( SUM ( fact_stock[acc_1484] ), LASTNONBLANK ( dim_month[Date], [_Остаток (сумма)] ) ) / 1000000000

// МЕРА
Счёт 1485, млрд ₸ =
CALCULATE ( SUM ( fact_stock[acc_1485] ), LASTNONBLANK ( dim_month[Date], [_Остаток (сумма)] ) ) / 1000000000


// ─────────────────────────────────────────────────────────────────────────────
//  3. ПЕРЕКЛЮЧАТЕЛЬ — одна мера на все матрицы
//     Строка формата — динамическая: Мера → Формат → Динамический →
//     вставить выражение ниже. Без неё все показатели выйдут в одном формате.
// ─────────────────────────────────────────────────────────────────────────────

// МЕРА
Значение =
SWITCH (
    SELECTEDVALUE ( 'Показатель'[Показатель] ),
    "Объём выдач, млрд ₸",                       [Объём выдач, млрд ₸],
    "Количество выдач",                          [Количество выдач],
    "Средняя сумма выдачи, млн ₸",               [Средняя сумма выдачи, млн ₸],
    "Срок по договору, мес",                     [Срок по договору, мес],
    "Лимиты по картам, млн ₸",                   [Лимиты по картам, млн ₸],
    "Полностью погашено",                        [Полностью погашено],
    "в т.ч. досрочно",                           [в т.ч. досрочно],
    "Доля досрочных",                            [Доля досрочных],
    "Фактический срок, мес",                     [Фактический срок, мес],
    "Закрыто с просрочкой на начало месяца",     [Закрыто с просрочкой на начало месяца],
    "Общий остаток, млрд ₸",                     [Общий остаток, млрд ₸],
    "Договоров с остатком",                      [Договоров с остатком],
    "Заёмщиков с остатком",                      [Заёмщиков с остатком],
    "Остаток на заёмщика, млн ₸",                [Остаток на заёмщика, млн ₸],
    "Управленческий уровень просрочки",          [Управленческий уровень просрочки],
    "Просроченная задолженность (1424), млрд ₸", [Просроченная задолженность (1424), млрд ₸],
    "Провизии (1428+1845+18771), млрд ₸",        [Провизии (1428+1845+18771), млрд ₸],
    "Покрытие провизиями",                       [Покрытие провизиями],
    "Счёт 1484, млрд ₸",                         [Счёт 1484, млрд ₸],
    "Счёт 1485, млрд ₸",                         [Счёт 1485, млрд ₸]
)

// ДИНАМИЧЕСКАЯ СТРОКА ФОРМАТА для меры [Значение]
SELECTEDVALUE ( 'Показатель'[Формат], "#,0.0" )

// МЕРА — запасной путь, если динамический формат недоступен или не срабатывает
// (сборка 24.09.2026: все показатели вышли в формате по умолчанию «#,0.0»).
// Возвращает текст: для таблиц годится, для графиков — нет.
Значение (текст) =
VAR _v = [Значение]
RETURN IF ( ISBLANK ( _v ), BLANK (), FORMAT ( _v, SELECTEDVALUE ( 'Показатель'[Формат], "#,0.0" ) ) )
