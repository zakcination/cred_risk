// PBI_tables.dax — СОБРАНО build_paste.py из PBI_model.dax. Руками не править.
// Каждый блок: Моделирование → Новая таблица → заменить «Таблица = » блоком → Enter.
// Порядок важен: dim_month читает fact_flow и fact_stock — сначала загрузить факты.

// ═══ 1. Меры
Меры =
ROW ( "служебный", BLANK () )

// ═══ 2. dim_source
dim_source =
DATATABLE (
    "l_source", STRING, "Источник", STRING, "Порядок", INTEGER,
    {
        { "S01", "RS",         1 },
        { "S02", "Карты",      2 },
        { "S03", "CrediLogic", 3 },
        { "S17", "Fenix",      4 }
    }
)

// ═══ 3. dim_month
dim_month =
VAR _mn = MIN ( MIN ( fact_flow[month_start] ), MIN ( fact_stock[month_start] ) )
VAR _mx = MAX ( MAX ( fact_flow[month_start] ), MAX ( fact_stock[month_start] ) )
VAR _mx_idx = YEAR ( _mx ) * 12 + MONTH ( _mx )
RETURN
    ADDCOLUMNS (
        FILTER ( CALENDAR ( _mn, _mx ), DAY ( [Date] ) = 1 ),
        "month_idx",    YEAR ( [Date] ) * 12 + MONTH ( [Date] ),
        "Месяц",        FORMAT ( [Date], "yyyy-MM" ),
        "Последние 12", YEAR ( [Date] ) * 12 + MONTH ( [Date] ) > _mx_idx - 12
    )

